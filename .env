# Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=20
POSTGRES_POOL_MIN=5

# Database URL for migrations (must match above credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketing

# Kafka Configuration
# KAFKA_BROKERS=localhost:9093
KAFKA_BROKERS=tramway.proxy.rlwy.net:55283
# Optional SASL Auth (for production/cloud Kafka)
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
